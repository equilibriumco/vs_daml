<?xml version="1.0" encoding="utf-8"?>
<!-- Daml.Sdk and Daml.Build.CSharp come from what scripts/pack.ps1 leaves in artifacts/packages; anything else,
     the Daml runtime and Splice packages among it, from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="daml-local" value="..\..\artifacts\packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="daml-local">
      <package pattern="Daml.Sdk" />
      <package pattern="Daml.Build.CSharp" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
