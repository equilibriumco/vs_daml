<!-- The Daml Script tests of the contracts. Build runs no tests; the EqDamlTest target
     (dotnet build -t:EqDamlTest) runs every script with dpm test. -->
<Project Sdk="Equilibrium.Daml.Sdk/0.3.0-preview.0">

  <!-- The tests use the contracts' DAR (data-dependencies in daml.yaml), so that project builds first. -->
  <ItemGroup>
    <ProjectReference Include="..\Contracts.msbuildproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
