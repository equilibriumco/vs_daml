template Coin
  with
    owner : Party
  where
    signatory owner
    interface instance Asset for Coin where
    -- <- keyword.declaration
              -- <- keyword.declaration
                       -- <- type
                             -- <- keyword.contract
                                 -- <- type
      view = AssetView with owner
      -- <- function.method
      getOwner = owner
      -- <- function.method
