<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- C# generated from the Daml project, as a user sets it up: the package, the runtime it compiles
       against and the reference that brings the DAR. -->
  <ItemGroup>
    <PackageReference Include="Equilibrium.Daml.Build.CSharp" Version="0.3.0-preview.0" PrivateAssets="all" />
    <PackageReference Include="Daml.Runtime" Version="0.6.0" />
    <PackageReference Include="Daml.Ledger.Abstractions" Version="0.6.0" />
    <EqDamlReference Include="..\Contracts\Contracts.msbuildproj" Namespace="SdkManual" />
  </ItemGroup>

</Project>
