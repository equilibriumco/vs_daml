    account : Text
    quantity : Decimal
    limit : Int
    tags : [Text]
  deriving (Eq, Show)

{- A block comment that spans
   several lines {- with a nested one -}
   before the template. -}
template Asset50
  with
    issuer : Party
    owner : Party
    amount : Decimal
    label : Text
    observers : [Party]
  where
    signatory issuer
    observer owner :: observers
    ensure amount > 0.0 && label /= ""

    choice Transfer50 : ContractId Asset50
      with
        newOwner : Party
      controller owner
      do
        assertMsg "cannot transfer to self" (newOwner /= owner)
        create this with owner = newOwner

    nonconsuming choice Inspect50 : (Text, Decimal)
      controller owner
      do
        pure (label, amount * 1.5e2)

    choice Split50 : (ContractId Asset50, ContractId Asset50)
      with
        splitAmount : Decimal
      controller owner
      do
        let rest = amount - splitAmount
        first <- create this with amount = splitAmount
        second <- create this with amount = rest
        return (first, second)

-- | Summarises a list of positions; uses `div` and a qualified map.
summarise50 : [Position50] -> Map.Map Text Int
summarise50 positions =
  let sizes = map (\p -> (p.account, p.limit `div` 2)) positions
  in Map.fromList (sortOn fst (dedup sizes))

classify50 : Int -> Text
classify50 x = case x of
  0 -> "zero"
  1 -> "one"
  _ | x < 0x10 -> "small"
    | x < 1_000_000 -> "medium"
    | otherwise -> "large"

test50 : Script ()
test50 = script do
  alice <- allocateParty "Alice50"
  bob <- allocateParty "Bob50"
  cid <- submit alice do
    createCmd Asset50 with
      issuer = alice; owner = alice; amount = 100.0; label = "asset 50"; observers = [bob]
  cid' <- submit alice do exerciseCmd cid Transfer50 with newOwner = bob
  (label, value) <- submit bob do exerciseCmd cid' Inspect50
  debug ("got " <> label <> " worth " <> show value) -- ^ trailing note
  pure ()

