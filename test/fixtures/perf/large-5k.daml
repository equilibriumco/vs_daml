{-# LANGUAGE ApplicativeDo #-}
-- | Benchmark input for the lexer: generated by generate-large-5k.ps1, do not edit by hand.
module Large where

import DA.List (sortOn, dedup)
import qualified DA.Map as Map
import DA.Optional (fromOptional)
import Daml.Script

-- | Holding number 1, with a few fields of every common type.
data Position1 = Position1 with
    account : Text
    quantity : Decimal
    limit : Int
    tags : [Text]
  deriving (Eq, Show)

{- A block comment that spans
   several lines {- with a nested one -}
   before the template. -}
template Asset1
  with
    issuer : Party
    owner : Party
    amount : Decimal
    label : Text
    observers : [Party]
  where
    signatory issuer
    observer owner :: observers
    ensure amount > 0.0 && label /= ""

    choice Transfer1 : ContractId Asset1
      with
        newOwner : Party
      controller owner
      do
        assertMsg "cannot transfer to self" (newOwner /= owner)
        create this with owner = newOwner

    nonconsuming choice Inspect1 : (Text, Decimal)
      controller owner
      do
        pure (label, amount * 1.5e2)

    choice Split1 : (ContractId Asset1, ContractId Asset1)
      with
        splitAmount : Decimal
      controller owner
      do
        let rest = amount - splitAmount
        first <- create this with amount = splitAmount
        second <- create this with amount = rest
        return (first, second)

-- | Summarises a list of positions; uses `div` and a qualified map.
summarise1 : [Position1] -> Map.Map Text Int
summarise1 positions =
  let sizes = map (\p -> (p.account, p.limit `div` 2)) positions
  in Map.fromList (sortOn fst (dedup sizes))

classify1 : Int -> Text
classify1 x = case x of
  0 -> "zero"
  1 -> "one"
  _ | x < 0x10 -> "small"
    | x < 1_000_000 -> "medium"
    | otherwise -> "large"

test1 : Script ()
test1 = script do
  alice <- allocateParty "Alice1"
  bob <- allocateParty "Bob1"
  cid <- submit alice do
    createCmd Asset1 with
      issuer = alice; owner = alice; amount = 100.0; label = "asset 1"; observers = [bob]
  cid' <- submit alice do exerciseCmd cid Transfer1 with newOwner = bob
  (label, value) <- submit bob do exerciseCmd cid' Inspect1
  debug ("got " <> label <> " worth " <> show value) -- ^ trailing note
  pure ()

