<Project Sdk="Microsoft.NET.Sdk">

  <!-- Every setting wrong at once: one build reports all of it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EqDamlOffline>true</EqDamlOffline>
    <EqDamlAllowToolInstall>true</EqDamlAllowToolInstall>
    <EqDamlLockTimeoutSeconds>0</EqDamlLockTimeoutSeconds>
    <EqDamlCodegenComponent>oci://ghcr.io/peacefulstudio/dpm-codegen-cs:latest</EqDamlCodegenComponent>
    <EqDamlGeneratedOutputMode>Source</EqDamlGeneratedOutputMode>
    <EqDamlGeneratedDir>.</EqDamlGeneratedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Equilibrium.Daml.Build.CSharp" Version="0.9.0-beta" PrivateAssets="all" />
    <PackageReference Include="Daml.Runtime" Version="0.6.0" />
    <EqDamlReference Include="..\vendor\finance-1.0.0.dar" />
    <EqDamlReference Include="..\Contracts\Contracts.msbuildproj" Namespace="My Contracts" />
    <EqDamlDar Include="..\vendor\ledger.dar" Namespace="Ledger" />
    <EqDamlDar Include="..\VENDOR\Ledger.dar" Namespace="Ledger" />
  </ItemGroup>

</Project>
