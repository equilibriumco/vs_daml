<Project Sdk="Microsoft.NET.Sdk">

  <!-- Two Daml projects with the same name and modules: without a namespace on one of them the
       generated types would collide. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Equilibrium.Daml.Build.CSharp" Version="0.3.0-preview" PrivateAssets="all" />
    <PackageReference Include="Daml.Runtime" Version="0.6.0" />
    <PackageReference Include="Daml.Ledger.Abstractions" Version="0.6.0" />
    <EqDamlReference Include="..\Contracts\Contracts.msbuildproj" />
    <EqDamlReference Include="..\Contracts2\Contracts.msbuildproj" Namespace="Second" />
  </ItemGroup>

</Project>
