<?xml version="1.0" encoding="utf-8"?>
<!-- Equilibrium.Daml.Sdk comes from what scripts/pack.ps1 leaves in artifacts/packages; NoTargets, which it imports, from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="daml-local" value="..\..\..\artifacts\packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="daml-local">
      <package pattern="Equilibrium.Daml.Sdk" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
