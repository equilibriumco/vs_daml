<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage settings used by scripts/test.ps1. Only product assemblies count: test projects
     and the shared test helpers would otherwise inflate (or dilute) the numbers. -->
<RunSettings>
  <!-- The .NET Framework test host runs the tests in a second app domain, and assemblies loaded
       there have their strong names verified: the instrumented copies coverlet writes no longer
       pass. The host's default domain doesn't verify. -->
  <RunConfiguration>
    <DisableAppDomain>true</DisableAppDomain>
  </RunConfiguration>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Equilibrium.Daml.*]*</Include>
          <Exclude>[Equilibrium.Daml.TestHelpers]*,[*.Tests]*,[*.IntegrationTests]*</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
