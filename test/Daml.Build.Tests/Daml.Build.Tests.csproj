    <TargetFrameworks>net48;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Verify.Xunit" />
    <!-- At run time here, unlike in the tasks project: the tests execute tasks in their own process. -->
    <PackageReference Include="Microsoft.Build.Framework" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Daml.Build.Core\Daml.Build.Core.csproj" />
    <ProjectReference Include="..\..\src\Daml.Build.Tasks\Daml.Build.Tasks.csproj" />
    <ProjectReference Include="..\TestHelpers\TestHelpers.csproj" />
  </ItemGroup>

</Project>
