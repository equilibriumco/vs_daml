<Project Sdk="Microsoft.NET.Sdk">

  <!-- BenchmarkDotNet runs, not tests: test.ps1 doesn't pick this project up (its name doesn't
       end in Tests). The budgets are set for net48 x64, where the editor runs; net10.0 is kept
       for comparison. Run it with scripts/bench.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- Roslyn's runtime, which Visual Studio provides to the product. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

  <!-- The binding index benchmark compiles generated C# that targets net10.0 and the Daml runtime:
       their assemblies are downloaded as plain files and handed to the compilation. -->
  <ItemGroup>
    <PackageDownload Include="Microsoft.NETCore.App.Ref" Version="[10.0.0]" />
    <PackageDownload Include="Daml.Runtime" Version="[0.6.0]" />
    <PackageDownload Include="Daml.Ledger.Abstractions" Version="[0.6.0]" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NuGetPackageRoot</_Parameter1>
      <_Parameter2>$(NuGetPackageRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Equilibrium.Daml.VisualStudio.Core\Equilibrium.Daml.VisualStudio.Core.csproj" />
    <ProjectReference Include="..\..\src\Equilibrium.Daml.VisualStudio.Roslyn\Equilibrium.Daml.VisualStudio.Roslyn.csproj" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so the run doesn't depend on where BenchmarkDotNet puts its generated build. -->
    <EmbeddedResource Include="..\fixtures\perf\large-5k.daml" LogicalName="large-5k.daml" />
    <EmbeddedResource Include="..\fixtures\bindings\kinds\csharp\**\*.cs" LogicalName="kinds/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The index lives in a net48 project, as it runs in Visual Studio; there is no net10.0 build to compare with. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <Compile Remove="BindingIndexBenchmarks.cs" />
  </ItemGroup>

</Project>
