<Project Sdk="Microsoft.NET.Sdk">

  <!-- Stand-in for Digital Asset's dpm. Built as dpm.exe so code under test can find it the
       same way it finds the real one. Behaviour comes from a JSON scenario; see Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>dpm</AssemblyName>
    <RootNamespace>Daml.TestFakes.Dpm</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- The exit codes the helpers in TestHelpers look for; one source for both. -->
  <ItemGroup>
    <Compile Include="..\TestHelpers\FakeDpmExitCodes.cs" Link="FakeDpmExitCodes.cs" />
  </ItemGroup>

</Project>
