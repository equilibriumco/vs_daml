<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared plumbing for the test projects: locating external tools, deciding whether a
       missing one skips a test or fails it, driving the fake dpm, and an in-memory file system. -->
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RootNamespace>Equilibrium.Daml.TestHelpers</RootNamespace>
    <AssemblyName>Equilibrium.Daml.TestHelpers</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="MessagePack" />
    <InternalsVisibleTo Include="Equilibrium.Daml.TestHelpers.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Equilibrium.Daml.VisualStudio.Core\Equilibrium.Daml.VisualStudio.Core.csproj" />
  </ItemGroup>

  <!-- Build the fakes first, but don't reference them: they are separate net10.0 executables
       that tests launch as processes, even from net48 test runs. -->
  <ItemGroup>
    <ProjectReference Include="..\FakeDpm\FakeDpm.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="TargetFramework" />
    <ProjectReference Include="..\FakeDamlLanguageServer\FakeDamlLanguageServer.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="TargetFramework" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FakeDpmDirectory</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\FakeDpm\bin\$(Configuration)\net10.0\'))</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FakeDamlLanguageServerDirectory</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\FakeDamlLanguageServer\bin\$(Configuration)\net10.0\'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
