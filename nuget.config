<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only these two feeds, whatever the machine-level config says. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Microsoft's public VS SDK feed; the in-IDE test harness is only published here. -->
    <add key="vssdk" value="https://pkgs.dev.azure.com/azure-public/vside/_packaging/vssdk/nuget/v3/index.json" />
  </packageSources>

  <!-- Source mapping: nothing but the harness may come from the extra feed. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="vssdk">
      <package pattern="Microsoft.VisualStudio.Extensibility.Testing.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
