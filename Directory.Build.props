<Project>

  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <!-- src | test | spikes; drives which analyzers and packaging rules apply. -->
    <RepoArea>$([MSBuild]::MakeRelative('$(RepoRoot)', '$(MSBuildProjectDirectory)').Split('\')[0])</RepoArea>
  </PropertyGroup>

  <PropertyGroup>
    <!-- C# 14 ships with the pinned .NET 10 SDK. net48/netstandard2.0 get the
         missing attributes from PolySharp (see Directory.Build.targets). -->
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML docs are enforced for public API in src only. -->
    <NoWarn Condition="'$(RepoArea)' != 'src'">$(NoWarn);CS1591</NoWarn>
    <!-- A freshly published advisory must not break every build; CI reports it instead. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- The Toolkit's Newtonsoft.Json check reads the VS SDK version from
         PackageReference metadata, which is empty under CPM, so it falsely flags
         13.0.3. Newtonsoft.Json is pinned to the 17.14 baseline in Directory.Packages.props. -->
    <CheckNewtonsoftJsonVersion>false</CheckNewtonsoftJsonVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(TF_BUILD)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Company>Equilibrium</Company>
    <Authors>Equilibrium</Authors>
    <Product>Daml for Visual Studio</Product>
    <Copyright>Copyright 2026 Equilibrium</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Only the projects that ship as NuGet packages opt back in. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- One version for everything. The VSIX manifest only accepts numeric versions, so the
       build number goes into the fourth part there and into the prerelease label on NuGet:
         VSIX / FileVersion   0.1.0.42
         NuGet                0.1.0-preview.42
       Local builds use build number 0; CI passes its run number. Drop DamlPrerelease for a
       stable release. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <DamlPrerelease>true</DamlPrerelease>
    <DamlBuildNumber Condition="'$(DamlBuildNumber)' == '' and '$(GITHUB_RUN_NUMBER)' != ''">$(GITHUB_RUN_NUMBER)</DamlBuildNumber>
    <DamlBuildNumber Condition="'$(DamlBuildNumber)' == ''">0</DamlBuildNumber>
    <VersionSuffix Condition="'$(DamlPrerelease)' == 'true'">preview.$(DamlBuildNumber)</VersionSuffix>
    <FileVersion>$(VersionPrefix).$(DamlBuildNumber)</FileVersion>
    <!-- Kept at major.minor so assemblies loaded into devenv don't change identity on every build. -->
    <AssemblyVersion>$(VersionPrefix.Split('.')[0]).$(VersionPrefix.Split('.')[1]).0.0</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RepoArea)' == 'test'">
    <!-- Microsoft.Extensions.TimeProvider.Testing ships a net462 lib but warns that
         .NET Framework is untested. Fine for tests; product code never loads it. -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

</Project>
