<Project>
  <Import Project="$(MSBuildThisFileDirectory)src\Equilibrium.Daml.Build.Core\Equilibrium.Daml.Build.Signing.props" />

  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <!-- src | test; drives which analyzers and packaging rules apply. -->
    <RepoArea>$([MSBuild]::MakeRelative('$(RepoRoot)', '$(MSBuildProjectDirectory)').Split('\')[0])</RepoArea>
  </PropertyGroup>

  <PropertyGroup>
    <!-- C# 14 ships with the pinned .NET 10 SDK. net48/netstandard2.0 get the
         missing attributes from PolySharp (see Directory.Build.targets). -->
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML docs are enforced for public API in src only. -->
    <NoWarn Condition="'$(RepoArea)' != 'src'">$(NoWarn);CS1591</NoWarn>
    <!-- A freshly published advisory must not break every build; CI reports it instead. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- The Toolkit's Newtonsoft.Json check reads the VS SDK version from
         PackageReference metadata, which is empty under CPM, so it falsely flags
         13.0.3. Newtonsoft.Json is pinned to the 17.14 baseline in Directory.Packages.props. -->
    <CheckNewtonsoftJsonVersion>false</CheckNewtonsoftJsonVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(TF_BUILD)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Company>Equilibrium</Company>
    <Authors>Equilibrium</Authors>
    <Product>EQ Daml Tools for Visual Studio</Product>
    <Copyright>Copyright 2026 Equilibrium</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/equilibriumco/vs_daml</PackageProjectUrl>
    <RepositoryUrl>https://github.com/equilibriumco/vs_daml</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- The commit the package was built from goes into the nuspec next to the URL. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Only the projects that ship as NuGet packages opt back in. -->
    <IsPackable>false</IsPackable>
    <!-- What the NuGet packages' ids start with (Equilibrium.Daml.Sdk, Equilibrium.Daml.Build.CSharp, Equilibrium.Daml.Templates): a working
         name until the use of the Daml name is agreed, so a new one renames packages, not code. -->
    <PackageIdPrefix>Equilibrium.Daml</PackageIdPrefix>
  </PropertyGroup>

  <!-- One version for everything. The VSIX manifest only accepts numeric versions, so the
       build number goes into the fourth part there and after the prerelease label on NuGet:
         VSIX / FileVersion   0.9.0.3
         NuGet                0.9.0-beta.3
       Local builds use build number 0; CI passes its run number. An empty label makes a stable
       release. -->
  <PropertyGroup>
    <VersionPrefix>0.9.0</VersionPrefix>
    <EqDamlPrereleaseLabel>beta</EqDamlPrereleaseLabel>
    <EqDamlBuildNumber Condition="'$(EqDamlBuildNumber)' == '' and '$(GITHUB_RUN_NUMBER)' != ''">$(GITHUB_RUN_NUMBER)</EqDamlBuildNumber>
    <EqDamlBuildNumber Condition="'$(EqDamlBuildNumber)' == ''">0</EqDamlBuildNumber>
    <VersionSuffix Condition="'$(EqDamlPrereleaseLabel)' != ''">$(EqDamlPrereleaseLabel).$(EqDamlBuildNumber)</VersionSuffix>
    <FileVersion>$(VersionPrefix).$(EqDamlBuildNumber)</FileVersion>
    <!-- Kept at major.minor so assemblies loaded into devenv don't change identity on every build. -->
    <AssemblyVersion>$(VersionPrefix.Split('.')[0]).$(VersionPrefix.Split('.')[1]).0.0</AssemblyVersion>
  </PropertyGroup>

  <!-- Strong-named libraries need strong-named dependencies and friend test assemblies on net48. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Equilibrium.Daml.Build.Core' or '$(MSBuildProjectName)' == 'Equilibrium.Daml.Build.Tasks' or '$(MSBuildProjectName)' == 'Equilibrium.Daml.VisualStudio.Core' or '$(MSBuildProjectName)' == 'TestHelpers' or '$(MSBuildProjectName)' == 'Equilibrium.Daml.Build.Tests' or '$(MSBuildProjectName)' == 'Equilibrium.Daml.VisualStudio.Core.Tests' or '$(MSBuildProjectName)' == 'TestHelpers.Tests'">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(RepoRoot)src\Equilibrium.Daml.Build.Core\Equilibrium.Daml.Build.snk</AssemblyOriginatorKeyFile>
    <PublicKey>$(EqDamlBuildPublicKey)</PublicKey>
    <AssemblyVersion>$(FileVersion)</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RepoArea)' == 'test'">
    <!-- Microsoft.Extensions.TimeProvider.Testing ships a net462 lib but warns that
         .NET Framework is untested. Fine for tests; product code never loads it. -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

</Project>
