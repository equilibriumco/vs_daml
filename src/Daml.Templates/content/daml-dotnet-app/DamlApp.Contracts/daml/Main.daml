module Main where

type AssetId = ContractId Asset

-- | Something an issuer creates for an owner, who can give it to someone else.
template Asset
  with
    issuer : Party
    owner : Party
    name : Text
  where
    ensure name /= ""
    signatory issuer
    observer owner

    choice Give : AssetId
      with
        newOwner : Party
      controller owner
      do create this with owner = newOwner
