<!-- Templates for dotnet new: a Daml contracts project with a project of Daml Script tests next to it,
     and a solution with both and a C# app on the generated bindings. The projects they create
     reference Equilibrium.Daml.Sdk and Equilibrium.Daml.Build.CSharp of the same release, so packing writes this package's
     version and id prefix into each template.json. -->
<Project Sdk="Microsoft.Build.NoTargets">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>$(PackageIdPrefix).Templates</PackageId>
    <PackageType>Template</PackageType>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- .template.config and .gitignore start with a dot, and NuGet leaves such files out by default. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- A template package has nothing for lib\. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <Description>dotnet new templates for Daml: daml-contracts (a Daml package with its Daml Script tests, built by MSBuild) and daml-dotnet-app (a solution with those and a C# app using the C# generated from them).</Description>
    <PackageTags>daml;canton;dotnet-new;templates</PackageTags>
    <!-- The VSIX carries the package for Visual Studio's New Project dialog, so every build makes it. -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <_EqDamlTemplateConfig Include="content\**\.template.config\template.json" />
    <None Include="content\**" Exclude="@(_EqDamlTemplateConfig)" Pack="true" PackagePath="content\" />
  </ItemGroup>

  <!-- Each template.json goes into the package with @PackageVersion@ and @PackageIdPrefix@ replaced. -->
  <Target Name="EqDamlStampTemplates" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <_EqDamlTemplateConfig>
        <Stamped>$(IntermediateOutputPath)templates\%(RecursiveDir)template.json</Stamped>
        <Text>$([System.IO.File]::ReadAllText('%(FullPath)').Replace('@PackageVersion@', '$(PackageVersion)').Replace('@PackageIdPrefix@', '$(PackageIdPrefix)'))</Text>
      </_EqDamlTemplateConfig>
    </ItemGroup>
    <WriteLinesToFile File="%(_EqDamlTemplateConfig.Stamped)" Lines="$([MSBuild]::Escape('%(_EqDamlTemplateConfig.Text)'))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="%(_EqDamlTemplateConfig.Stamped)" Pack="true" PackagePath="content\%(_EqDamlTemplateConfig.RecursiveDir)" />
      <FileWrites Include="%(_EqDamlTemplateConfig.Stamped)" />
    </ItemGroup>
  </Target>

  <!-- Where the build put the package; reads only, so the VSIX can ask for it after the build. -->
  <Target Name="EqDamlTemplatesPackage" Returns="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(PackageOutputPath)', '$(PackageId).$(PackageVersion).nupkg'))" />

</Project>
