{
  "$schema": "http://json.schemastore.org/template",
  "author": "Equilibrium",
  "classifications": [ "Windows", "Console" ],
  "identity": "Equilibrium.Daml.Templates.DotnetApp",
  "name": "Daml and .NET App",
  "description": "A solution with a Daml package, its Daml Script tests and a C# console app that uses the C# generated from the package in the same build (Equilibrium.Daml.Sdk and Equilibrium.Daml.Build.CSharp).",
  "shortName": "daml-dotnet-app",
  "tags": {
    "language": "Daml",
    "type": "solution"
  },
  "preferNameDirectory": true,
  "symbols": {
    "HostIdentifier": {
      "type": "bind",
      "binding": "HostIdentifier"
    },
    "SafeName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "safe_namespace",
      "replaces": "DamlApp",
      "fileRename": "DamlApp"
    },
    "EqDamlPackageName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "damlPackageName",
      "replaces": "daml-app"
    },
    "EqDamlSdkVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "3.6.0",
      "replaces": "EQDAML_SDK_VERSION",
      "description": "The Daml SDK the packages are built with (sdk-version in daml.yaml); install it with dpm install <version>."
    },
    "AllowToolInstall": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Let the first build on a machine download the pinned C# code generator (EqDamlAllowToolInstall in the app's project). Without it, a machine that hasn't got the generator yet needs one build with EqDamlAllowToolInstall=true first."
    },
    "EqDamlPackagesVersion": {
      "type": "generated",
      "generator": "constant",
      "parameters": { "value": "@PackageVersion@" },
      "replaces": "EQDAML_PACKAGES_VERSION"
    },
    "EqDamlPackageIdPrefix": {
      "type": "generated",
      "generator": "constant",
      "parameters": { "value": "@PackageIdPrefix@" },
      "replaces": "EQDAML_PACKAGE_PREFIX"
    }
  },
  "forms": {
    "damlPackageName": {
      "identifier": "chain",
      "steps": [ "dashes", "lowerCase" ]
    },
    "dashes": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9]+",
      "replacement": "-"
    },
    "lowerCase": {
      "identifier": "lowerCase"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
          "exclude": [ "DamlApp.slnx" ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    {
      "condition": "(HostIdentifier == \"dotnetcli\" || HostIdentifier == \"dotnetcli-preview\")",
      "path": "DamlApp.slnx"
    },
    {
      "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
      "path": "DamlApp/DamlApp.csproj"
    },
    {
      "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
      "path": "DamlApp.Contracts/DamlApp.Contracts.msbuildproj"
    },
    {
      "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
      "path": "DamlApp.Contracts.Tests/DamlApp.Contracts.Tests.msbuildproj"
    }
  ]
}
