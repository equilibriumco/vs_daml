<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host-independent logic: syntax, project model, SDK resolution. No VS or Roslyn types here. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reads dpm's JSON output. VS ships it, so it stays out of the VSIX. -->
    <PackageReference Include="Newtonsoft.Json" />
    <!-- ReadOnlySpan for the lexer on netstandard2.0. -->
    <PackageReference Include="System.Memory" />
    <!-- TimeProvider for netstandard2.0, so the results windows debouncing is testable. Ships in the VSIX with its own codebase entry. -->
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
  </ItemGroup>

  <ItemGroup>
    <!-- Manifests, paths, diagnostic parsing and dpm arguments, shared with the MSBuild tasks.
         Build.Core depends on YamlDotNet alone, so the tasks never load this assembly or its packages. -->
    <ProjectReference Include="..\Daml.Build.Core\Daml.Build.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Daml.VisualStudio.Core.Tests" />
  </ItemGroup>

</Project>
