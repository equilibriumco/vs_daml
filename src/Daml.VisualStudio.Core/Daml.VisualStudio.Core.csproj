<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host-independent logic: syntax, project model, SDK resolution. No VS or Roslyn types here. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Manifest parsing (daml.yaml, multi-package.yaml); ships in the VSIX with its own codebase entry. -->
    <PackageReference Include="YamlDotNet" />
    <!-- Reads dpm's JSON output. VS ships it, so it stays out of the VSIX. -->
    <PackageReference Include="Newtonsoft.Json" />
    <!-- ReadOnlySpan for the lexer on netstandard2.0. -->
    <PackageReference Include="System.Memory" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Daml.VisualStudio.Core.Tests" />
  </ItemGroup>

</Project>
