<Project>

  <Import Project="Sdk.targets" Sdk="Microsoft.Build.NoTargets" Version="3.7.134" />

  <UsingTask TaskName="Daml.Build.Tasks.ReadDamlManifest" AssemblyFile="$(_DamlSdkTasks)" />
  <UsingTask TaskName="Daml.Build.Tasks.DamlComputeBuildState" AssemblyFile="$(_DamlSdkTasks)" />
  <UsingTask TaskName="Daml.Build.Tasks.DamlBuildTask" AssemblyFile="$(_DamlSdkTasks)" />
  <UsingTask TaskName="Daml.Build.Tasks.DamlRecordBuildState" AssemblyFile="$(_DamlSdkTasks)" />
  <UsingTask TaskName="Daml.Build.Tasks.DamlTestTask" AssemblyFile="$(_DamlSdkTasks)" />
  <UsingTask TaskName="Daml.Build.Tasks.DamlReadDarProvenance" AssemblyFile="$(_DamlSdkTasks)" />
  <UsingTask TaskName="Daml.Build.Tasks.DamlCleanPackage" AssemblyFile="$(_DamlSdkTasks)" />

  <!-- What Solution Explorer and Visual Studio's up-to-date check see: the manifest and the
       package's sources. They are read from daml.yaml while the project is evaluated, when no task
       can run; the build itself goes by ReadDamlManifest. A single source file brings its folder,
       where damlc finds what it imports. -->
  <PropertyGroup>
    <_DamlPackageRoot>$([System.IO.Path]::GetDirectoryName('$(DamlManifestPath)'))</_DamlPackageRoot>
    <_DamlManifestText Condition="Exists('$(DamlManifestPath)')">$([System.IO.File]::ReadAllText('$(DamlManifestPath)'))</_DamlManifestText>
    <_DamlSourceSetting>$([System.Text.RegularExpressions.Regex]::Match('$(_DamlManifestText)', '(?m)^source:[ \t]*[^\r\n#]*').Value)</_DamlSourceSetting>
    <_DamlSourceSetting>$([System.Text.RegularExpressions.Regex]::Replace('$(_DamlSourceSetting)', '^source:|\x22|\x27', '').Trim())</_DamlSourceSetting>
    <_DamlSourceFolder Condition="'$(_DamlSourceSetting)' != ''">$([MSBuild]::NormalizeDirectory('$(_DamlPackageRoot)', '$(_DamlSourceSetting)'))</_DamlSourceFolder>
    <_DamlSourceFolder Condition="'$(_DamlSourceSetting)' != '' and $(_DamlSourceSetting.EndsWith('.daml'))">$([MSBuild]::NormalizeDirectory('$(_DamlPackageRoot)', '$([System.IO.Path]::GetDirectoryName('$(_DamlSourceSetting)'))'))</_DamlSourceFolder>
    <_DamlBuildStatePath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'daml.build.state'))</_DamlBuildStatePath>
    <!-- A Daml project has no NuGet packages to resolve, and may never have been restored: a C#
         project's DamlReference becomes a project reference only in that project's package
         targets, which its restore doesn't see, so building the C# project alone builds this one
         unrestored. -->
    <SkipResolvePackageAssets Condition="'$(SkipResolvePackageAssets)' == '' and !Exists('$(ProjectAssetsFile)')">true</SkipResolvePackageAssets>
  </PropertyGroup>

  <ItemGroup Condition="'$(_DamlSourceFolder)' != ''">
    <DamlSource Include="$(_DamlSourceFolder)**\*.daml" Exclude="$(_DamlSourceFolder)**\.daml\**;$(_DamlSourceFolder)**\obj\**;$(_DamlSourceFolder)**\bin\**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(DamlManifestPath)" Condition="Exists('$(DamlManifestPath)')" />
    <None Include="@(DamlSource)" />
  </ItemGroup>

  <!-- NoTargets assigns CoreBuildDependsOn outright at the end of its targets, so Daml's targets can
       only join the lists here, after that import; anything set earlier is lost. -->
  <PropertyGroup>
    <CoreBuildDependsOn>$(CoreBuildDependsOn);DamlBuild</CoreBuildDependsOn>
    <CleanDependsOn>$(CleanDependsOn);DamlClean</CleanDependsOn>
    <CollectUpToDateCheckInputDesignTimeDependsOn>$(CollectUpToDateCheckInputDesignTimeDependsOn);DamlCollectUpToDateCheckItems</CollectUpToDateCheckInputDesignTimeDependsOn>
    <CollectUpToDateCheckBuiltDesignTimeDependsOn>$(CollectUpToDateCheckBuiltDesignTimeDependsOn);DamlCollectUpToDateCheckItems</CollectUpToDateCheckBuiltDesignTimeDependsOn>
  </PropertyGroup>

  <!-- Order comes from DependsOnTargets alone. A target's condition is judged before its
       dependencies run, so "only in a real build" sits on the tasks, never on the targets. -->

  <!-- What the manifest says: the package, its SDK, where its sources are and where its DAR goes. -->
  <Target Name="DamlResolveManifest">
    <ReadDamlManifest ManifestPath="$(DamlManifestPath)">
      <Output TaskParameter="PackageName" PropertyName="DamlPackageName" />
      <Output TaskParameter="PackageVersion" PropertyName="DamlPackageVersion" />
      <Output TaskParameter="SdkVersion" PropertyName="DamlSdkVersion" />
      <Output TaskParameter="SourcePath" PropertyName="DamlSourcePath" />
      <Output TaskParameter="DarPath" PropertyName="DamlDarPath" />
      <Output TaskParameter="Dependencies" ItemName="DamlDependency" />
      <Output TaskParameter="DataDependencies" ItemName="DamlDataDependency" />
    </ReadDamlManifest>
  </Target>

  <!-- Whether the DAR is current, judged from what it is built from before deciding to skip the
       build: Inputs and Outputs alone would miss a deleted or renamed source. -->
  <Target Name="DamlComputeBuildState" DependsOnTargets="DamlResolveManifest">
    <DamlComputeBuildState
        Condition="'$(DesignTimeBuild)' != 'true'"
        ManifestPath="$(DamlManifestPath)"
        SourcePath="$(DamlSourcePath)"
        DarPath="$(DamlDarPath)"
        StatePath="$(_DamlBuildStatePath)"
        Dependencies="@(DamlDependency)"
        DataDependencies="@(DamlDataDependency)"
        BuildEnabled="$(DamlBuildEnabled)">
      <Output TaskParameter="ShouldBuild" PropertyName="_DamlShouldBuild" />
      <Output TaskParameter="Fingerprint" PropertyName="_DamlBuildFingerprint" />
      <Output TaskParameter="SourceFingerprint" PropertyName="_DamlSourceFingerprint" />
    </DamlComputeBuildState>
  </Target>

  <Target Name="DamlBuild" DependsOnTargets="DamlResolveManifest;DamlComputeBuildState">
    <DamlBuildTask
        Condition="'$(_DamlShouldBuild)' == 'true'"
        ManifestPath="$(DamlManifestPath)"
        DarPath="$(DamlDarPath)"
        DpmPath="$(DamlDpmPath)"
        Offline="$(DamlOffline)"
        AllowToolInstall="$(DamlAllowToolInstall)"
        SkipPreflight="$(DamlSkipPreflight)"
        ProcessTimeoutSeconds="$(DamlProcessTimeoutSeconds)"
        LockTimeoutSeconds="$(DamlLockTimeoutSeconds)">
      <Output TaskParameter="CreatedDar" PropertyName="DamlCreatedDar" />
    </DamlBuildTask>
    <DamlRecordBuildState
        Condition="'$(DamlCreatedDar)' != ''"
        StatePath="$(_DamlBuildStatePath)"
        DarPath="$(DamlDarPath)"
        Fingerprint="$(_DamlBuildFingerprint)"
        SourceFingerprint="$(_DamlSourceFingerprint)"
        ManifestPath="$(DamlManifestPath)"
        SourcePath="$(DamlSourcePath)"
        Dependencies="@(DamlDependency)"
        DataDependencies="@(DamlDataDependency)" />
    <!-- A build that found the DAR current tells Visual Studio's up-to-date check so, or the
         check would keep asking for it. -->
    <Touch Condition="'$(_DamlShouldBuild)' == 'false' and Exists('$(_DamlBuildStatePath)')" Files="$(_DamlBuildStatePath)" />
    <Message Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(DamlDarPath)')" Importance="high" Text="$(MSBuildProjectName) -> $(DamlDarPath)" />
  </Target>

  <!-- What a referencing project asks for: the DAR and where it came from, its package id from the
       DAR itself and the sources its build recorded. Only reads, so design-time builds can ask;
       never builds, as the reference builds this project first. -->
  <Target Name="GetDamlDar" DependsOnTargets="DamlResolveManifest" Returns="@(_DamlDarOutput)">
    <DamlReadDarProvenance DarPath="$(DamlDarPath)" StatePath="$(_DamlBuildStatePath)">
      <Output TaskParameter="MainPackageId" PropertyName="_DamlMainPackageId" />
      <Output TaskParameter="SourceFingerprint" PropertyName="_DamlRecordedSources" />
    </DamlReadDarProvenance>
    <ItemGroup>
      <_DamlDarOutput Include="$(DamlDarPath)">
        <DamlPackageName>$(DamlPackageName)</DamlPackageName>
        <DamlPackageVersion>$(DamlPackageVersion)</DamlPackageVersion>
        <DamlSdkVersion>$(DamlSdkVersion)</DamlSdkVersion>
        <DamlMainPackageId>$(_DamlMainPackageId)</DamlMainPackageId>
        <DamlSourceProject>$(MSBuildProjectFullPath)</DamlSourceProject>
        <DamlSourceFingerprint>$(_DamlRecordedSources)</DamlSourceFingerprint>
        <DamlManifest>$(DamlManifestPath)</DamlManifest>
        <Exists>$([System.IO.File]::Exists('$(DamlDarPath)'))</Exists>
      </_DamlDarOutput>
    </ItemGroup>
  </Target>

  <!-- Only on request: dotnet build -t:DamlTest. -->
  <Target Name="DamlTest" DependsOnTargets="DamlBuild">
    <DamlTestTask
        Condition="'$(DesignTimeBuild)' != 'true'"
        ManifestPath="$(DamlManifestPath)"
        DpmPath="$(DamlDpmPath)"
        Offline="$(DamlOffline)"
        AllowToolInstall="$(DamlAllowToolInstall)"
        SkipPreflight="$(DamlSkipPreflight)"
        ProcessTimeoutSeconds="$(DamlProcessTimeoutSeconds)"
        LockTimeoutSeconds="$(DamlLockTimeoutSeconds)" />
  </Target>

  <!-- The package's own outputs only: its DAR and the build's record, never a dpm cache. -->
  <Target Name="DamlClean" DependsOnTargets="DamlResolveManifest">
    <DamlCleanPackage
        ManifestPath="$(DamlManifestPath)"
        DarPath="$(DamlDarPath)"
        StatePath="$(_DamlBuildStatePath)"
        LockTimeoutSeconds="$(DamlLockTimeoutSeconds)" />
  </Target>

  <!-- What Visual Studio's fast up-to-date check has to know about a Daml project: what the DAR is
       built from, and the DAR with the record of its build. -->
  <Target Name="DamlCollectUpToDateCheckItems" DependsOnTargets="DamlResolveManifest">
    <ItemGroup>
      <UpToDateCheckInput Include="$(DamlManifestPath);@(DamlSource);@(DamlDataDependency)" />
      <UpToDateCheckBuilt Include="$(DamlDarPath);$(_DamlBuildStatePath)" />
    </ItemGroup>
  </Target>

</Project>
