<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared by the MSBuild tasks and the VSIX, so it must not depend on anything VS-specific
       (the tasks also load under dotnet build). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- The NuGet packages ship it in tasks\, where a symbol package can't reach it, so the PDB
         travels inside the assembly. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- daml.yaml and multi-package.yaml. The tasks carry it next to their own assembly; the VSIX
         ships it with its own codebase entry. Its only dependency. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Equilibrium.Daml.Build.Tests" PublicKey="$(EqDamlBuildPublicKey)" />
  </ItemGroup>

</Project>
