<!-- Daml.Build.CSharp: generates C# from the DARs a C# project references and compiles it with the
     project. These are the defaults of its settings; set any of them in the project to change it. -->
<Project>

  <PropertyGroup>
    <DamlCodegenEnabled Condition="'$(DamlCodegenEnabled)' == ''">true</DamlCodegenEnabled>
    <DamlCodegenComponent Condition="'$(DamlCodegenComponent)' == ''">oci://ghcr.io/peacefulstudio/dpm-codegen-cs:0.6.0@sha256:9f040219936298f085e2ade77fbbc37829df065b879633282aa4628c9a1b6548</DamlCodegenComponent>
    <DamlGeneratedOutputMode Condition="'$(DamlGeneratedOutputMode)' == ''">Intermediate</DamlGeneratedOutputMode>
    <DamlJavaHome Condition="'$(DamlJavaHome)' == ''">$(JAVA_HOME)</DamlJavaHome>
    <_DamlCSharpTasks>$(MSBuildThisFileDirectory)..\tasks\netstandard2.0\Daml.Build.Tasks.dll</_DamlCSharpTasks>
  </PropertyGroup>

</Project>
