<Project Sdk="Microsoft.NET.Sdk">

  <!-- The MSBuild tasks of the Daml packages: thin adapters over Equilibrium.Daml.Build.Core. netstandard2.0
       and no Runtime on UsingTask, so the same assembly loads in-proc in MSBuild.exe and in
       dotnet build. MSBuild's own assemblies come from the host. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- The output folder is what the packages ship next to the tasks: their own assemblies and
         YamlDotNet. MSBuild's, excluded below, never land in it. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Equilibrium.Daml.Build.Core\Equilibrium.Daml.Build.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Equilibrium.Daml.Build.Tests" PublicKey="$(DamlBuildPublicKey)" />
  </ItemGroup>

</Project>
