<!-- Packs the Daml build tasks into tasks\netstandard2.0\ of the package project that imports this,
     with their own dependencies: everything Equilibrium.Daml.Build.Tasks puts in its output folder. The tasks
     project is built first and never referenced as an assembly. -->
<Project>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)Equilibrium.Daml.Build.Tasks\Equilibrium.Daml.Build.Tasks.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- The tasks bring YamlDotNet, whose MIT notice has to travel with it. -->
    <None Include="$(MSBuildThisFileDirectory)..\NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <Target Name="EqDamlPackTasks" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="$(MSBuildThisFileDirectory)Equilibrium.Daml.Build.Tasks\Equilibrium.Daml.Build.Tasks.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_EqDamlTasksAssembly" />
    </MSBuild>
    <PropertyGroup>
      <_EqDamlTasksFolder>@(_EqDamlTasksAssembly->'%(RootDir)%(Directory)')</_EqDamlTasksFolder>
    </PropertyGroup>
    <ItemGroup>
      <None Include="$(_EqDamlTasksFolder)*.dll" Pack="true" PackagePath="tasks\netstandard2.0\" />
    </ItemGroup>
  </Target>

</Project>
