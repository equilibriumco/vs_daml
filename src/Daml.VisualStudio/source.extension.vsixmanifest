<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <!-- The Id is the extension's identity in the Marketplace and in every user's install;
         never change it after the first public release. Version comes from the project. -->
    <Identity Id="Daml.VisualStudio.e536ad39-5d35-4aba-a4ae-7bcc5b3fae1e" Version="|%CurrentProject%;GetVsixVersion|" Language="en-US" Publisher="Equilibrium" />
    <DisplayName>Daml for Visual Studio</DisplayName>
    <Description xml:space="preserve">Daml language support for Visual Studio: native editing features, diagnostics, navigation and Open Folder builds through the Daml SDK.</Description>
    <License>LICENSE</License>
    <Tags>Daml, Canton, smart contracts, LSP</Tags>
    <Preview>true</Preview>
  </Metadata>
  <Installation>
    <!-- VS 2026 only. The SDK packages we compile against are 17.14 (nuget.org has no 18.x);
         VS 2026 redirects them to its own assemblies. -->
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[18.0,)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.8,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[18.0,)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="LanguageConfiguration\DamlLanguageConfiguration.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%|" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="Templates\DamlTemplates.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.ItemTemplate" d:Source="File" Path="ItemTemplates" />
  </Assets>
</PackageManifest>
