<Project Sdk="Microsoft.NET.Sdk">

  <!-- damlc process supervision and the daml/* protocol pieces. Talks JSON-RPC, never VS UI. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Daml.VisualStudio.Core\Daml.VisualStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TimeProvider for netstandard2.0, so backoff timing is testable. -->
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <!-- VS's own JSON-RPC connection is handed to us; VS ships the assembly, so it isn't packaged. -->
    <PackageReference Include="StreamJsonRpc" ExcludeAssets="runtime" />
    <!-- Used directly for message bodies; the VS-shipped version is the one pinned centrally. -->
    <PackageReference Include="Newtonsoft.Json" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Daml.VisualStudio.LanguageServer.Tests" />
  </ItemGroup>

</Project>
